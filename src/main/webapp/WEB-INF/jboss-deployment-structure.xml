<?xml version="1.0" encoding="UTF-8"?>
<jboss-deployment-structure>
    <deployment>
        <exclusions>
            <!-- Excluir logging de WildFly -->
            <module name="org.apache.commons.logging"/>
            <module name="org.apache.logging.log4j.api"/>
            <module name="org.slf4j"/>
            <module name="org.slf4j.impl"/>
            <module name="org.jboss.logging"/>
        </exclusions>
        <dependencies>
            <module name="jakarta.servlet.api" export="true"/>
            <!-- Las librerias jakarta.mail se incluyen dentro del WAR (org.eclipse.angus:jakarta.mail) -->
            <!-- No se declaran como modulos del servidor porque WildFly 27 no los tiene instalados -->
        </dependencies>
    </deployment>
</jboss-deployment-structure>
